rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/pantry/{id} {
   allow read, delete: if request.auth != null && request.auth.uid == uid;
   allow create, update: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['name','quantity','category','expires'])
    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
    && request.resource.data.quantity is int && request.resource.data.quantity >= 1 && request.resource.data.quantity <= 9999
    && request.resource.data.category in ['Produce','Grains','Dairy','Protein','Other']
    && request.resource.data.expires is string && request.resource.data.expires.size() <= 10;
  }
  match /users/{uid}/feedback/{id} {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow create, update: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['rating','question','answer','createdAt'])
    && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
    && request.resource.data.question is string && request.resource.data.question.size() <= 4000
    && request.resource.data.answer is string && request.resource.data.answer.size() <= 16000
    && request.resource.data.createdAt is string;
  }
 }
}
